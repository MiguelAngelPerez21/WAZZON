# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is git-ignored. NEVER commit real credentials.
# ---------------------------------------------------------------------------

# --- Supabase (required in runtime, optional to build) ---------------------
# Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings -> API -> Project API keys -> anon / public
# This key is PUBLIC by design. All access control is enforced by RLS policies.
# Newer Supabase projects call it "publishable" and it starts with
# `sb_publishable_`; `NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY` is also accepted.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Site ------------------------------------------------------------------
# Absolute public URL, no trailing slash. Used for canonicals, sitemap,
# robots.txt, Open Graph metadata and the same-origin check on /api/events/*.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Images (optional) -----------------------------------------------------
# Comma-separated extra hostnames allowed through the Next.js image optimizer.
# Any host NOT in this list is still rendered, but with a plain <img> tag so the
# optimizer can never be abused as an open image proxy.
# Example: NEXT_PUBLIC_IMAGE_ALLOWED_HOSTS=img.kwcdn.com,m.media-amazon.com
NEXT_PUBLIC_IMAGE_ALLOWED_HOSTS=

# ---------------------------------------------------------------------------
# NOT USED — intentionally.
#
# SUPABASE_SERVICE_ROLE_KEY is deliberately NOT part of this application.
# The service-role key bypasses Row Level Security, so a single mistake would
# expose every table. Everything this app does (public reads, admin writes,
# anonymous outbound-click tracking) is expressed as RLS policies executed with
# the `anon` or the logged-in user's role instead. See SECURITY.md.
# ---------------------------------------------------------------------------
